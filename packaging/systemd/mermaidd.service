[Unit]
Description=Mermaid local AI runtime daemon
Documentation=https://github.com/noahsabaj/mermaid-cli#readme
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/mermaidd
Restart=on-failure
RestartSec=2
Environment=MERMAID_DAEMON_TCP_ADDR=127.0.0.1:39871

[Install]
WantedBy=default.target
